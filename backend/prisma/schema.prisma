generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Investigation {
  id              String     @id @default(uuid())
  target          String     // johndoe@gmail.com 
  type            String     // types: 'USERNAME', 'EMAIL', 'PHONE'
  status          Status     @default(PENDING)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  isMonitoring    Boolean    @default(false)
  lastMonitoredAt DateTime?
  monitoringCount Int        @default(0) 

  artifacts  Artifact[]  
}

model Artifact { 
  id                String     @id @default(uuid())
  source            String // Источник
  data              Json
  discoveredAt      DateTime   @default(now())

  investigationId   String
  investigation     Investigation  @relation(fields: [investigationId], references: [id])
}